# LevyMate Environment Variables
# Copy this file to .env.local and fill in your values

# Paystack public key (for checkout)
# Get your key from: https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_test_key_here

# Note: GEMINI_API_KEY is now handled by the Lambda proxy
# Set it using: npx ampx sandbox secret set GEMINI_API_KEY
